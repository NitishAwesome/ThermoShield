# ==============================================================================
# ThermoShield Environment Template (.env.example)
# ==============================================================================

# Database Configuration:
DATABASE_URL=sqlite:///backend/thermoshield.db

# Sample PostgreSQL Database:
# DATABASE_URL=postgresql://user:password@localhost:5432/thermoshield

# JWT Secret:
JWT_SECRET=replace-with-a-long-random-secret

# Frontend API URL:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Regional phone alerts. Demo is the safe default; no messages are sent.
REGIONAL_DELIVERY_MODE=demo
ENABLE_REGIONAL_DISPATCH=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Exact public HTTPS URL, with no query string:
TWILIO_STATUS_CALLBACK_URL=https://your-api.example/api/regional-alerts/twilio/status
