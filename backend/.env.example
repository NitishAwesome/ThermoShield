# ==============================================================================
# ThermoShield Backend Environment Configuration
# Copy this file to .env and replace placeholder values.
# ==============================================================================

# Database
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/thermoshield

# Environment
ENVIRONMENT=development

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# Database connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Development database behavior
ALLOW_SQLITE_FALLBACK=false
AUTO_CREATE_TABLES=false

# Nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Firebase
# Configure this according to the Firebase credential strategy documented
# in the project setup instructions.
GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-service-account.json

# Optional email alerts
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=