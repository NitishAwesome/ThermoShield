# ==============================================================================
# ThermoShield Backend Environment Configuration Template (.env.example)
# ==============================================================================

# Database Options:
# SQLite (Default):
DATABASE_URL=sqlite:///thermoshield.db

# PostgreSQL Sample:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/thermoshield

# Cloud PostgreSQL Sample (Supabase / Render / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Authentication JWT Secret:
JWT_SECRET=your-secure-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Allowed Origins for CORS:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Alerts (Optional):
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# SMS Alerts (Twilio - Optional):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
